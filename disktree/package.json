{
  "name": "disktree",
  "version": "0.2.0",
  "description": "See what fills your disk: a GPU-rendered treemap of any folder, built with GPUIX",
  "license": "Apache-2.0",
  "type": "module",
  "bin": "dist/cli.js",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./src": {
      "types": "./src/app.tsx",
      "default": "./src/app.tsx"
    },
    "./src/*": {
      "types": "./src/*.tsx",
      "default": "./src/*.tsx"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "bun --hot src/cli.tsx",
    "test": "vitest run --dir src",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/gpuix",
    "directory": "disktree"
  },
  "homepage": "https://github.com/remorses/gpuix/tree/main/disktree",
  "bugs": "https://github.com/remorses/gpuix/issues",
  "keywords": [
    "disk",
    "disk-usage",
    "treemap",
    "du",
    "gpuix",
    "gpui"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@gpuix/native": "workspace:^",
    "@gpuix/react": "workspace:^",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
