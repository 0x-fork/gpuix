{
  "name": "gpuix-hermes",
  "private": true,
  "description": "Run a GPUIX React app on hermes-node instead of Node or Bun.",
  "scripts": {
    "build": "bun build.ts",
    "start": "hermes-node --no-compile-cache app.cjs",
    "bundle": "hermes-node --build-bundle=dist/app.bundle app.cjs",
    "exe": "hermes-node --build-exe=dist/gpuix-hermes --kit=\"$HERMES_NODE_KIT\" dist/app.bundle"
  }
}
